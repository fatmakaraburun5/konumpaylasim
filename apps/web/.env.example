# Konum web görüntüleyici: hepsi derlemeye gömülür (gizli değer YOK).
# Üretim (Firebase RTDB, europe-west1):
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=https://<proje-id>-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API (HTTP referrer kısıtlı, yalnızca Maps JavaScript API). Boşsa yedek görünüm.
VITE_GOOGLE_MAPS_WEB_KEY=

# Mağaza bağlantıları (boşsa rozetler "Yakında").
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Yerel emülatör: 1 ise RTDB emülatörüne bağlanır (proje demo-konum, ad alanı demo-konum).
VITE_USE_EMULATORS=
VITE_RTDB_EMULATOR_HOST=127.0.0.1:9000
VITE_RTDB_NAMESPACE=demo-konum
