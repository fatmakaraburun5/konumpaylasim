# Kopyalayın: cp .env.example .env  (Expo CLI .env dosyasını app.config.ts'ten önce yükler)

# Google Maps SDK anahtarları (react-native-maps PROVIDER_GOOGLE, iki platformda da)
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# Firebase yapılandırma dosyaları (varsayılanlar ./firebase/ altında)
GOOGLE_SERVICES_JSON=./firebase/google-services.json
GOOGLE_SERVICE_INFO_PLIST=./firebase/GoogleService-Info.plist

# Geliştirme: App Check debug token (Firebase konsolunda kayıtlı olmalı). Boşsa SDK üretir ve loglar.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Geliştirme: Local Emulator Suite'e bağlan (1 = evet). Android emülatöründen bilgisayar = 10.0.2.2
EXPO_PUBLIC_USE_EMULATORS=0
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Üretim derlemesi (EAS profili otomatik verir). "production" ise Maps anahtarları zorunlu.
# APP_VARIANT=production

# Faz 2: QR / paylaşım bağlantısı alan adı (https://<LINK_DOMAIN>/s/<token>). iOS Associated Domains ve
# Android App Links bu alan adıyla kurulur; alan adında AASA + assetlinks.json yayınlanmalı (bkz. README).
# Boşsa yer tutucu: konum.example.com
LINK_DOMAIN=
