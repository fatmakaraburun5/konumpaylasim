{
  "name": "@konum/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Konum Cloud Functions (Faz 1 + Faz 2: callable'lar, ACL aynaları, bağlantı paylaşımı, Maps vekili, süre dolumu taraması). @konum/core esbuild ile lib/ içine gömülür.",
  "main": "lib/index.js",
