<?xml version="1.0" encoding="utf-8"?>
<!-- Faz 6: 2x2 widget (RemoteViews: yalnızca FrameLayout / LinearLayout / TextView / ImageView / Chronometer). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/konum_w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/konum_w_bg"
  android:padding="10dp">

  <LinearLayout
    android:id="@+id/konum_w_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/konum_w_avatar"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:contentDescription="@null"
      android:scaleType="fitCenter" />

    <TextView
      android:id="@+id/konum_w_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="@color/konum_w_text"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/konum_w_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="@color/konum_w_text2"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/konum_w_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="@color/konum_w_text2"
      android:textSize="10sp"
      android:visibility="gone" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/konum_w_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/konum_w_btn"
      android:gravity="center"
      android:maxLines="1"
      android:paddingLeft="12dp"
      android:paddingTop="5dp"
      android:paddingRight="12dp"
      android:paddingBottom="5dp"
      android:text="@string/konum_w_quick"
      android:textColor="@color/konum_w_on_accent"
      android:textSize="12sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/konum_w_timer_box"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:text="@string/konum_w_sharing"
        android:textColor="@color/konum_w_accent"
        android:textSize="11sp" />

      <Chronometer
        android:id="@+id/konum_w_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/konum_w_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/konum_w_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:textColor="@color/konum_w_text2"
    android:textSize="13sp"
    android:visibility="gone" />
</FrameLayout>
