rules_version = '2';

// Konum Firestore kuralları (Faz 1 + Faz 2 + Faz 4 + Faz 5 + Faz 6).
//  - Varsayılan: her şey kapalı.
//  - İstemci sosyal grafiğe ve paylaşımlara YAZMAZ; tüm geçişler Cloud Functions callable'larıyla.
//  - Okuma yalnızca ilgili taraflara. Kurallar filtre değildir: istemci sorgusu kısıtı taşımalıdır
//    (where sender_id == uid, where receiver_id == uid, where member_ids array-contains uid + status ...).
//  - ops, users_private, phone_index, invite_codes, rate_limits, acl_pending, deleted_users, phone_blocks,
//    outgoing_request_links: istemciye tamamen kapalı (kural yok).
//  - Faz 2: link_acl_pending, route_cache, geocode_cache, maps_quota, maps_budget, config: istemciye tamamen
//    kapalı (yalnızca Functions). Google yanıtları yalnızca callable üzerinden döner.
//  - Faz 5: zone_cooldowns, meetup_cache: istemciye tamamen kapalı (yalnızca Functions).
//  - Faz 6: widget_tokens istemciye tamamen kapalı (yalnızca Functions; düz token yok, sha256 özeti kimliktir).
//    users/{uid} içindeki gender / favorite_ids / avatar_* yalnızca sahibine görünür; arkadaşlar cinsiyeti ve
//    fotoğrafı friendships.member_profiles kopyasından görür.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Kendi profili: yalnızca sahibi okur. Arkadaşların adı friendships.member_profiles içindedir.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      // Giden arkadaşlık istekleri: yalnızca sahibi okur. Hedef kayıtlı olsun olmasın, engelli olsun olmasın
      // aynı kayıt yazılır ve hedefin uid'ini İÇERMEZ (maskeli telefon / davet kodu).
      match /outgoing_requests/{oid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Faz 5: kayıtlı bölgeler + kurallar. Merkez ev / iş adresidir: YALNIZCA sahibi okur (kural alıcıları dahil
      // kimse göremez); yalnızca zone_upsert / zone_delete yazar.
      match /zones/{zoneId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Faz 5: bölge olay kaydı (koordinatsız; 30 gün TTL). Yalnızca sahibi okur; yalnızca zone_event_report yazar.
      match /zone_events/{eventId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Arkadaşlık:
    //  - kabul edilmiş: iki üye okur (sorgu: member_ids array-contains ben + status == 'accepted');
    //  - bekleyen: YALNIZCA hedef okur (sorgu: target_id == ben + status == 'pending').
    // İsteyen kendi bekleyen isteğini göremez: aksi hâlde numaranın kayıtlı olduğu, hedefin uid'i ve
    // "engelledi / reddetti" ayrımı isteyene sızardı. İsteyenin görünümü users/{uid}/outgoing_requests.
    match /friendships/{friendshipId} {
      allow read: if signedIn() && (
        (resource.data.status == 'accepted' && request.auth.uid in resource.data.member_ids)
        || (resource.data.status == 'pending' && resource.data.target_id == request.auth.uid)
      );
      allow write: if false;
    }

    // Engelleme: yalnızca engelleyen okur (sorgu: blocker_id == uid). Engellenen hiçbir şey görmez
    // (paylaşım belgelerine de 'blocked' nedeni yazılmaz).
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blocker_id == request.auth.uid;
      allow write: if false;
    }

    // Yönlü paylaşım: yalnızca gönderen ve alıcı okur. Alıcı başka alıcıları göremez
    // (her alıcının ayrı belgesi vardır ve belgede receiver_ids listesi yoktur).
    match /location_shares/{shareId} {
      allow read: if signedIn()
        && (resource.data.sender_id == request.auth.uid || resource.data.receiver_id == request.auth.uid);
      allow write: if false;
    }

    // Konum isteği: isteyen ve hedef okur.
    match /location_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.requester_id == request.auth.uid || resource.data.target_id == request.auth.uid);
      allow write: if false;
    }

    // FCM token'ları: sahibi şemaya uygun yazar/siler; başka kimse okuyamaz.
    // updated_at: epoch ms (Date.now() + sunucu saat farkı); fark kesirli olabildiği için tam sayı zorunlu değil
    // [Varsayım: doğrulanmalı]. Sahiplik sunucuda çözülür (aynı token iki uid altında olabilir, bkz. push.ts).
    match /devices/{uid}/tokens/{tokenId} {
      function validToken(d) {
        return d.keys().hasOnly(['token', 'platform', 'updated_at'])
          && d.keys().hasAll(['token', 'platform', 'updated_at'])
          && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
          && d.platform in ['ios', 'android']
          && d.updated_at is number && d.updated_at > 0;
      }
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && validToken(request.resource.data);
      allow delete: if isSelf(uid);
    }

    // Faz 2: bağlantı (QR) paylaşımı. Yalnızca gönderen okur (sorgu: sender_id == ben [+ status]); hiç kimse
    // yazamaz. Belgede düz token YOKTUR (yalnızca token_hash). Token sahibi (web / uygulama) bu belgeyi okumaz,
    // yalnızca RTDB link_live/{token_hash} düğümünü okur.
    match /link_shares/{linkId} {
      allow read: if signedIn() && resource.data.sender_id == request.auth.uid;
      allow write: if false;
    }

    // Faz 4: yer notları. Sahibi (sorgu: owner_id == ben) ve sahibin seçtiği arkadaşlar (sorgu: visible_to
    // array-contains ben) okur; yalnızca place_note_upsert / place_note_delete yazar. Süresi geçen notu okuma tarafı
    // gizler, süpürücü siler. [Varsayım] Okuyan arkadaş visible_to listesini görür (Firestore alan gizlemez).
    match /place_notes/{noteId} {
      allow read: if signedIn()
        && (resource.data.owner_id == request.auth.uid || request.auth.uid in resource.data.visible_to);
      allow write: if false;
    }

    // Faz 4: acil durum uyarıları. Gönderen (sorgu: sender_id == ben) ve alıcılar (sorgu: recipient_ids
    // array-contains ben) okur; yalnızca sos_* callable'ları yazar. Belge TAM koordinat taşır: başka kimse okuyamaz.
    match /sos_alerts/{sosId} {
      allow read: if signedIn()
        && (resource.data.sender_id == request.auth.uid || request.auth.uid in resource.data.recipient_ids);
      allow write: if false;
    }

    // Faz 5: paylaşılan buluşma önerileri. Öneren (sorgu: from == ben) ve alıcılar (sorgu: to array-contains ben)
    // okur; yalnızca meetup_* callable'ları yazar. [Varsayım] Alıcı diğer alıcıları ve herkesin ETA'sını görür
    // (öneri grup içindir).
    match /meetups/{meetupId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || request.auth.uid in resource.data.to);
      allow write: if false;
    }

    // Faz 6: widget hızlı paylaşım token'ları. Hiçbir istemci okuyamaz / yazamaz (widget uzantısı bile:
    // widget_quick_share callable'ı token'ı sunucuda doğrular).
    match /widget_tokens/{tokenHash} {
      allow read, write: if false;
    }

    // Açıkça: geri kalan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
