    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "libphonenumber-js": "^1.13.17",
    "typescript": "~5.9.3",
    "zod": "^4.6.7"
  }
}
