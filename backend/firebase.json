{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        "build.mjs",
        "tsconfig.json",
        ".git",
        "*.log",
        "lib/*.map"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run typecheck",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": [
    {
      "target": "live",
      "rules": "database.rules.json"
    }
  ],
  "hosting": {
    "public": "hosting/dist",
    "predeploy": [
      "node \"$PROJECT_DIR/hosting/assemble.mjs\""
    ],
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/s/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/s/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-store"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9499
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hosting": {
      "host": "127.0.0.1",
      "port": 5050
    }
  }
}
